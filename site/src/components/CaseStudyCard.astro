---
// One case study in a grid. The title is the link; a CSS trick makes the
// whole card clickable without wrapping block content in an <a>.
import type { CollectionEntry } from 'astro:content';
import { stageLabel } from '../lib/labels';

interface Props {
  study: CollectionEntry<'case-studies'>;
  headingLevel?: 'h2' | 'h3';
}

const { study, headingLevel = 'h3' } = Astro.props;
const { title, description, stage, date, metrics = [], published } = study.data;
const Heading = headingLevel;
---

<article class="card card--link cs-card">
  <div class="cs-card__meta">
    <span class="badge">{stageLabel(stage)}</span>
    <span>
      {date && date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}
      {!published && <strong> · Draft</strong>}
    </span>
  </div>
  <Heading><a href={`/case-studies/${study.id}/`}>{title}</a></Heading>
  <p>{description}</p>
  {metrics.length > 0 && (
    <div class="cs-card__metrics">
      {metrics.slice(0, 3).map((metric) => (
        <span class="metric"><strong>{metric.value}</strong><span>{metric.label}</span></span>
      ))}
    </div>
  )}
</article>
