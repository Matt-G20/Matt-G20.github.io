---
// Shared HTML shell for every page: one place for title, meta, canonical,
// the font, the header and the footer.
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { GOOGLE_SITE_VERIFICATION } from '../site';
// Imported once here, so every page gets the same styles.
import '../styles/global.css';
// Only the Latin file of the variable font (27 KB, all weights). "?url" gives
// its final hashed address so it can be preloaded below.
import fontUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  // Optional JSON-LD objects; each is printed in its own script tag.
  schema?: object[];
  // True for pages that must stay out of Google (e.g. 404).
  noindex?: boolean;
  // Share image path in public/; 1200×630 px.
  image?: string;
}

const {
  title,
  description,
  schema = [],
  noindex = false,
  image = '/og-image.png',
} = Astro.props;

// Astro.site comes from `site` in astro.config.mjs.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonicalURL} />
    )}
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#090c17" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={`@font-face{font-family:'Plus Jakarta Sans Variable';font-style:normal;font-display:swap;font-weight:200 800;src:url(${fontUrl}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`} />
    <!-- Marks that JavaScript runs, so the phone menu can fold away (it stays open without JS). -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Open Graph: how the page looks when shared on LinkedIn and others -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Matin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {schema.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
