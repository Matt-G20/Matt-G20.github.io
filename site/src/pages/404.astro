---
// GitHub Pages serves dist/404.html for any URL that does not exist.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Page Not Found — Matin"
  description="This page does not exist. Go to the home page, the case studies or the contact page."
  noindex
>
  <section class="page-head page-head--tall">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1>This page doesn't exist</h1>
      <p class="lead">The link may be old or mistyped. These pages are a good place to continue:</p>
      <div class="actions">
        <a class="button" href="/"><Icon name="arrow-left" size={18} /> Home page</a>
        <a class="button button--ghost" href="/case-studies/">Case studies</a>
        <a class="button button--ghost" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
