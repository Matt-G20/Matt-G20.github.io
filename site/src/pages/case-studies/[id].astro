---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { getVisibleCaseStudies } from '../../lib/case-studies';
import { stageLabel } from '../../lib/labels';

// Static site: Astro must know every URL at build time.
// One page is built for each visible case study.
export async function getStaticPaths() {
  const caseStudies = await getVisibleCaseStudies();
  return caseStudies.map((study) => ({
    params: { id: study.id },
    props: { study, others: caseStudies.filter((other) => other.id !== study.id).slice(0, 3) },
  }));
}

const { study, others } = Astro.props;
const { title, description, stage, date, tools, metrics, repo, demo, project_id } = study.data;
// Turns the Markdown body into HTML.
const { Content } = await render(study);
---

<BaseLayout title={title} description={description}>
  <section class="page-head">
    <div class="container">
      <a class="back-link" href="/case-studies/"><Icon name="arrow-left" size={18} /> All case studies</a>
      <p class="eyebrow">{stageLabel(stage)} · {project_id}</p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
    </div>
  </section>

  <section class="section pt-0" aria-label="Case study">
    <div class="container cs-layout">
      <article class="prose">
        <Content />
      </article>
      <aside class="facts" aria-label="Project facts">
        <div class="card">
          <dl>
            <div><dt>Stage</dt><dd>{stageLabel(stage)}</dd></div>
            {date && <div><dt>Date</dt><dd>{date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</dd></div>}
            {tools.length > 0 && (
              <div>
                <dt>Tools</dt>
                <dd><ul class="chips">{tools.map((tool) => <li class="chip">{tool}</li>)}</ul></dd>
              </div>
            )}
            {metrics.length > 0 && (
              <div>
                <dt>Results</dt>
                <dd class="grid gap-2">
                  {metrics.map((metric) => <span class="metric"><strong>{metric.value}</strong><span>{metric.label}</span></span>)}
                </dd>
              </div>
            )}
          </dl>
          {(demo || repo) && (
            <div class="actions mt-6">
              {demo && <a class="button button--small" href={demo}>Live demo <Icon name="external" size={16} /></a>}
              {repo && <a class="button button--small button--ghost" href={repo} rel="noopener" target="_blank">Code <Icon name="github" size={16} /></a>}
            </div>
          )}
        </div>
      </aside>
    </div>
  </section>

  {others.length > 0 && (
    <section class="section section--soft" aria-labelledby="more-title">
      <div class="container">
        <div class="section-head">
          <h2 id="more-title">More case studies</h2>
        </div>
        <div class="grid grid--3">
          {others.map((other) => <CaseStudyCard study={other} />)}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>
